{
  "name": "dsh-pwsh-unconfined",
  "version": "1.0.0",
  "description": "DeepSeek Harness plugin: keep the pwsh tool usable on Windows when the ACL restricted-token sandbox runner fails with STATUS_DLL_INIT_FAILED (0xC0000142).",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "pwsh",
    "powershell",
    "shell",
    "sandbox",
    "windows",
    "0xc0000142"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "author": "slientmo",
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    },
    "engines": {
      "dsh": ">=0.2.1-rc.3"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-pwsh-sandbox": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-pwsh-sandbox": {
      "optional": true
    }
  }
}
